{
    "name": "LVINS",
    "image": "slam_user:latest",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/slam/workspace/src/FAST_LIO,type=bind,consistency=cached",
    "workspaceFolder": "/home/slam/workspace/src/FAST_LIO",
    "runArgs": [
        "--net",
        "host",
        "--gpus",
        "all",
        "-e",
        "DISPLAY=:1"
    ],
    "mounts": [
        {
            "source": "/media/ym/BLUE",
            "target": "/media/ym/BLUE",
            "type": "bind"
        },
        {
            "source": "/tmp/.X11-unix",
            "target": "/tmp/.X11-unix",
            "type": "bind"
        }
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "jeff-hykin.better-cpp-syntax",
                "twxs.cmake",
                "ms-vscode.cmake-tools",
                "redhat.vscode-yaml",
                "dbankier.vscode-quick-select",
                "gruntfuggly.todo-tree",
                "mutantdino.resourcemonitor",
                "ryu1kn.partial-diff",
                "formulahendry.code-runner",
                "redhat.vscode-xml",
                "mutantdino.resourcemonitor",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "donjayamanne.githistory"
            ]
        }
    }
}
<launch>
  <arg name="scene_name" default="scene_0001"/>
  <arg name="bagfile" default="/media/ym/BLUE/Datasets/全国激光雷达大会数据处理大赛/sequence_01_0000_0550.bag"/>
  <arg name="output_dir" default="$(find fast_lio)/result/competition"/>
  <arg name="rviz" default="false"/>
  <arg name="play_rate" default="1.0"/>

  <rosparam command="load" file="$(find fast_lio)/config/competition_airy.yaml"/>

  <!-- Override machine-specific paths from YAML. -->
  <param name="common/output_path" type="string" value="$(arg output_dir)"/>
  <param name="competition_output/enabled" type="bool" value="true"/>
  <param name="competition_output/scene_name" type="string" value="$(arg scene_name)"/>
  <param name="competition_output/output_dir" type="string" value="$(arg output_dir)"/>

  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="point_filter_num" type="int" value="1"/>
  <param name="max_iteration" type="int" value="4"/>
  <param name="filter_size_surf" type="double" value="0.4"/>
  <param name="filter_size_map" type="double" value="0.4"/>
  <param name="cube_side_length" type="double" value="1000"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>

  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>


  <!-- Play only the LiDAR-inertial topics used by this sub-track. -->
  <node pkg="rosbag" type="play" name="competition_bag"
        args="--delay=2 -r $(arg play_rate) $(arg bagfile) --topics /rslidar_front_points /rslidar_front_imu_data"
        output="screen"/>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz"/>
  </group>
</launch>
